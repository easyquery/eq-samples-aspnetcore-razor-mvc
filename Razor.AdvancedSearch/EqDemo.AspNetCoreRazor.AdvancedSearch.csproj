<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>EqDemo.AspNetCoreRazor.AdvancedSearch</UserSecretsId>
    <TypeScriptCompileBlocked>True</TypeScriptCompileBlocked>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Data\EqDemoData.zip" />
    <None Remove="App_Data\NWindSQL.xml" />
    <None Remove="EasyQuery.lck" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Data\EqDemoData.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Data\NWindSQL.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\ServiceDependencies\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" VersionOverride="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" VersionOverride="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" VersionOverride="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" VersionOverride="10.0.2" />
    <!-- Transitive pin: EF Core 10.0.x still resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries
         CVE-2025-6965 (NU1903). Can be dropped once EF Core ships with SQLitePCLRaw 2.1.12 or later. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <!-- DB initialization packages. They are not necessary for EasyQuery working and can be removed in production -->
    <PackageReference Include="Korzh.DbUtils.Import" />
    <PackageReference Include="Korzh.DbUtils.Sqlite" />
    <PackageReference Include="Korzh.DbUtils.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EasyData.Exporters.ClosedXML" />
    <PackageReference Include="EasyData.Exporters.PdfSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Korzh.EasyQuery.AspNetCore" />
    <PackageReference Include="Korzh.EasyQuery.DataExport" />
    <PackageReference Include="Korzh.EasyQuery.EntityFrameworkCore.Relational" />
    <PackageReference Include="Korzh.EasyQuery.RazorUI" />
    <PackageReference Include="Korzh.EasyQuery.SqLiteGate" />
    <PackageReference Include="Korzh.EasyQuery.SqlServerGate" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\css\site.css">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>